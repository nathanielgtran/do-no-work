#!/bin/bash
# Apply fleet defaults to an existing GitHub repo. Idempotent; one line per setting.
#
# Usage: repo-bootstrap <owner/repo> [--public] [--dry-run] [--review]
#   --public   warn if any workflow uses a self-hosted runner (fork PRs could reach it)
#   --review   only set up the CI Claude review: REVIEWED label, Actions allowlist pins,
#              caller workflow (via PR; an existing caller is hardened/updated via PR),
#              skip-changelog on that PR when the label exists, CLAUDE_CODE_OAUTH_TOKEN secret
#   --dry-run  print the mutating calls without making them (reads still run)
#
# Env:
#   BOOTSTRAP_ACTIONS  comma list of allowed action patterns
#                      (default astral-sh/setup-uv@*,gitleaks/gitleaks-action@*)
#   BOOTSTRAP_CHECKS   comma list of required status checks; unset skips that rule
#   CLAUDE_CODE_OAUTH_TOKEN  --review: set as the repo secret when absent (sent via stdin)
#   BOOTSTRAP_REVIEW_RUNS_ON  --review, private repos: runner label or JSON list, or auto (default):
#                      the repo's single nuc-* runner label, else nuc, else ubuntu-latest
#   BOOTSTRAP_REVIEW_REF      --review: ref of BOOTSTRAP_REVIEW_SRC to pin the caller to (default: HEAD of
#                      its default branch); resolved to a 40-hex commit SHA
#   BOOTSTRAP_REVIEW_SRC      --review: repo holding the reusable workflow (default nathanielgtran/do-no-work)
set -euo pipefail

DRY_RUN=0
PUBLIC=0
REVIEW=0
REPO=""
REVIEW_SRC="${BOOTSTRAP_REVIEW_SRC:-nathanielgtran/do-no-work}"
REVIEW_BRANCH="NO-TICKET-claude-review"
HARDEN_BRANCH="NO-TICKET-claude-review-harden"
HARDEN_TITLE="[NO-TICKET] ci: harden Claude review caller (pin SHA, fork guard)"
LABELS="[]" REVIEW_SHA="" RUNS_ON_JSON=""
CALLER_PATH=".github/workflows/review.yml"
ST_LABEL="-" ST_ALLOW="-" ST_CALLER="-" ST_SECRET="-"
RULESET_NAME="protect-main"
ACTIONS="${BOOTSTRAP_ACTIONS:-astral-sh/setup-uv@*,gitleaks/gitleaks-action@*}"

die() { echo "repo-bootstrap: $*" >&2; exit 1; }

apply() {
  local label="$1" method="$2" endpoint="$3"
  shift 3
  if [ "$DRY_RUN" = 1 ]; then
    printf 'dry  %s %s (%s)\n' "$method" "$endpoint" "$label"
    return
  fi
  gh api -X "$method" "$endpoint" "$@" >/dev/null || die "failed: $label ($method $endpoint)"
  printf 'ok   %s\n' "$label"
}

parse_args() {
  local a
  for a in "$@"; do
    case "$a" in
      --public) PUBLIC=1 ;;
      --dry-run) DRY_RUN=1 ;;
      --review) REVIEW=1 ;;
      -*) die "unknown flag: $a" ;;
      *) [ -z "$REPO" ] || die "unexpected argument: $a"; REPO="$a" ;;
    esac
  done
  [[ "$REPO" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] || die "usage: repo-bootstrap <owner/repo> [--public] [--dry-run] [--review]"
}

setup_actions() {
  local r="repos/$REPO/actions/permissions" pat
  local args=()
  apply "actions: read-only token, no PR approval" PUT "$r/workflow" \
    -f default_workflow_permissions=read -F can_approve_pull_request_reviews=false
  apply "actions: fork PR approval for all external contributors" PUT "$r/fork-pr-contributor-approval" \
    -f approval_policy=all_external_contributors
  apply "actions: enabled, selected actions only" PUT "$r" \
    -F enabled=true -f allowed_actions=selected
  while IFS= read -r pat; do
    if [ -n "$pat" ]; then args+=(-f "patterns_allowed[]=$pat"); fi
  done < <(tr ',' '\n' <<<"$ACTIONS")
  apply "actions: allowlist ($ACTIONS)" PUT "$r/selected-actions" \
    -F github_owned_allowed=true -F verified_allowed=false ${args[@]+"${args[@]}"}
}

setup_repo() {
  apply "repo: squash-only, auto-delete branches, no wiki/projects, secret scanning" PATCH "repos/$REPO" \
    -F has_wiki=false -F has_projects=false -F delete_branch_on_merge=true \
    -F allow_merge_commit=false -F allow_rebase_merge=false -F allow_squash_merge=true \
    -f 'security_and_analysis[secret_scanning][status]=enabled' \
    -f 'security_and_analysis[secret_scanning_push_protection][status]=enabled'
  apply "security: private vulnerability reporting" PUT "repos/$REPO/private-vulnerability-reporting"
  apply "security: dependabot alerts" PUT "repos/$REPO/vulnerability-alerts"
  apply "security: dependabot security updates" PUT "repos/$REPO/automated-security-fixes"
}

setup_label() {
  LABELS=$(gh api "repos/$REPO/labels?per_page=100") || die "failed to list labels"
  if jq -e '.[] | select(.name == "REVIEWED")' <<<"$LABELS" >/dev/null; then
    echo "ok   label REVIEWED already exists"
    ST_LABEL=ok
    return
  fi
  apply "label REVIEWED created" POST "repos/$REPO/labels" -f name=REVIEWED -f color=0e8a16
  ST_LABEL=created
  if [ "$DRY_RUN" = 1 ]; then ST_LABEL=planned; fi
}

ruleset_body() {
  local checks="$1"
  jq -n --arg name "$RULESET_NAME" --arg checks "$checks" '
    {name: $name, target: "branch", enforcement: "active",
     conditions: {ref_name: {include: ["~DEFAULT_BRANCH"], exclude: []}},
     rules: ([{type: "deletion"}, {type: "non_fast_forward"},
       {type: "pull_request", parameters: {
         required_approving_review_count: 0, dismiss_stale_reviews_on_push: true,
         require_code_owner_review: false, require_last_push_approval: false,
         required_review_thread_resolution: false}}]
       + (if $checks == "" then [] else
          [{type: "required_status_checks", parameters: {
            strict_required_status_checks_policy: false,
            required_status_checks: ($checks | split(",") | map(select(. != "") | {context: .}))}}]
          end))}'
}

setup_ruleset() {
  local existing id body
  [ -n "${BOOTSTRAP_CHECKS:-}" ] || echo "skip required_status_checks: BOOTSTRAP_CHECKS not set"
  body=$(ruleset_body "${BOOTSTRAP_CHECKS:-}")
  existing=$(gh api "repos/$REPO/rulesets") || die "failed to list rulesets"
  id=$(jq -r --arg n "$RULESET_NAME" '[.[] | select(.name == $n) | .id][0] // empty' <<<"$existing")
  if [ -n "$id" ]; then
    apply "ruleset $RULESET_NAME updated (id $id)" PUT "repos/$REPO/rulesets/$id" --input - <<<"$body"
  else
    apply "ruleset $RULESET_NAME created" POST "repos/$REPO/rulesets" --input - <<<"$body"
  fi
}

warn_self_hosted() {
  local list names name content found=0
  if ! list=$(gh api "repos/$REPO/contents/.github/workflows" 2>&1); then
    grep -qi 'not found' <<<"$list" || die "failed to list workflows: $list"
    echo "ok   public: no workflows to check"
    return
  fi
  names=$(jq -r '.[] | select(.name | test("\\.ya?ml$")) | .name' <<<"$list")
  while IFS= read -r name; do
    [ -n "$name" ] || continue
    content=$(gh api -H 'Accept: application/vnd.github.raw' "repos/$REPO/contents/.github/workflows/$name") \
      || die "failed to read workflow $name"
    if grep -E 'runs-on:.*self-hosted|^[[:space:]]*-[[:space:]]*self-hosted' <<<"$content" >/dev/null; then
      echo "WARNING: $name uses a self-hosted runner; fork PRs on a public repo could target it" >&2
      found=1
    fi
  done <<<"$names"
  [ "$found" = 1 ] || echo "ok   public: no self-hosted runners in workflows"
}

raw_file() {
  gh api -H 'Accept: application/vnd.github.raw' "$1"
}

action_pins() {
  local wf action_ref action_yml bun
  wf=$(raw_file "repos/$REVIEW_SRC/contents/.github/workflows/claude-review.yml?ref=$REVIEW_SHA") \
    || die "failed to read claude-review.yml from $REVIEW_SRC"
  action_ref=$(grep -oE 'anthropics/claude-code-action@[A-Za-z0-9._-]+' <<<"$wf" | head -1 || true)
  [ -n "$action_ref" ] || die "no anthropics/claude-code-action pin in claude-review.yml"
  action_yml=$(raw_file "repos/anthropics/claude-code-action/contents/action.yml?ref=${action_ref#*@}") \
    || die "failed to read action.yml at ${action_ref#*@}"
  bun=$(grep -oE 'oven-sh/setup-bun@[A-Za-z0-9._-]+' <<<"$action_yml" | head -1 || true)
  [ -n "$bun" ] || die "no oven-sh/setup-bun pin in action.yml at ${action_ref#*@}"
  printf '%s\n%s\n' "$action_ref" "$bun"
}

setup_review_allowlist() {
  local mode cur pins merged r="repos/$REPO/actions/permissions"
  mode=$(gh api "$r" --jq .allowed_actions) || die "failed to read actions permissions"
  if [ "$mode" != selected ]; then
    echo "ok   allowlist: allowed_actions=$mode, nothing to add"
    ST_ALLOW="skip($mode)"
    return
  fi
  pins=$(action_pins)
  cur=$(gh api "$r/selected-actions") || die "failed to read selected-actions"
  merged=$(jq --arg pins "$pins" '
    .patterns_allowed = ((.patterns_allowed // []) + ($pins | split("\n") | map(select(. != ""))) | unique)
    | {github_owned_allowed: (.github_owned_allowed // true),
       verified_allowed: (.verified_allowed // false), patterns_allowed}' <<<"$cur")
  if jq -e --argjson m "$merged" '(.patterns_allowed // []) | sort == ($m.patterns_allowed | sort)' <<<"$cur" >/dev/null; then
    echo "ok   allowlist already has $(tr '\n' ' ' <<<"$pins")"
    ST_ALLOW=ok
    return
  fi
  apply "actions: allowlist + $(tr '\n' ' ' <<<"$pins")" PUT "$r/selected-actions" --input - <<<"$merged"
  ST_ALLOW=updated
  if [ "$DRY_RUN" = 1 ]; then ST_ALLOW=planned; fi
}

runs_on_json() {
  local v="$1"
  case "$v" in *"'"*) die "BOOTSTRAP_REVIEW_RUNS_ON must not contain a single quote" ;; esac
  case "$v" in
    \[*|\"*) printf '%s' "$v" ;;
    *) printf '"%s"' "$v" ;;
  esac
}

# Sets RUNS_ON_JSON. Private repos: an explicit BOOTSTRAP_REVIEW_RUNS_ON wins; unset/auto picks
# the repo-specific nuc-* label, else nuc, else ubuntu-latest (with a printed note).
resolve_runs_on() {
  local v="${BOOTSTRAP_REVIEW_RUNS_ON:-auto}" out labels specific
  RUNS_ON_JSON='"ubuntu-latest"'
  if [ "$PUBLIC" = 1 ]; then return; fi
  if [ "$v" != auto ]; then RUNS_ON_JSON=$(runs_on_json "$v"); return; fi
  if ! out=$(gh api "repos/$REPO/actions/runners?per_page=100" 2>&1); then
    echo "note runner: cannot list runners for $REPO, using ubuntu-latest"
    return
  fi
  labels=$(jq -r '[.runners[]?.labels[]?.name] | unique | .[]' <<<"$out") || die "failed to parse runners"
  specific=$(grep '^nuc-' <<<"$labels" || true)
  if [ "$(grep -c '^nuc-' <<<"$labels" || true)" = 1 ]; then
    RUNS_ON_JSON="[\"self-hosted\",\"$specific\"]"
  elif grep -qx nuc <<<"$labels"; then
    RUNS_ON_JSON='["self-hosted","nuc"]'
  else
    echo "note runner: no nuc self-hosted runner on $REPO, using ubuntu-latest"
    return
  fi
  echo "ok   runner: $RUNS_ON_JSON"
}

resolve_review_sha() {
  local ref="${BOOTSTRAP_REVIEW_REF:-HEAD}" sha
  [[ "$ref" =~ ^[A-Za-z0-9._/-]+$ ]] || die "invalid BOOTSTRAP_REVIEW_REF: $ref"
  sha=$(gh api "repos/$REVIEW_SRC/commits/$ref" --jq .sha) || die "failed to resolve $ref in $REVIEW_SRC"
  [[ "$sha" =~ ^[0-9a-f]{40}$ ]] || die "$REVIEW_SRC $ref did not resolve to a 40-hex commit SHA: $sha"
  REVIEW_SHA="$sha"
}

# render_caller <template>: needs REVIEW_SHA and RUNS_ON_JSON. Comment lines are dropped,
# the trailing "# do-no-work <short>" on the uses line stays.
render_caller() {
  grep -vE '^[[:space:]]*#' <<<"$1" | awk -v sha="$REVIEW_SHA" -v short="${REVIEW_SHA:0:7}" \
    -v ro="$RUNS_ON_JSON" -v pub="$PUBLIC" '
    /__RUNS_ON__/ { if (pub == 1) next; gsub(/__RUNS_ON__/, ro) }
    { gsub(/__SHA__/, sha); gsub(/__SHORT__/, short); print }'
}

caller_body() {
  cat <<BODY
## What
Adds .github/workflows/review.yml, a caller for the reusable Claude review workflow in $REVIEW_SRC, pinned to ${REVIEW_SHA:0:7} with a fork guard.

## Why
The review applies the REVIEWED label so the merge gate can allow merges.

## Proof
Generated by repo-bootstrap --review from examples/claude-review-caller.yml at $REVIEW_SHA. The file diff shows the job-level fork guard, the full-SHA pin, and tools-ref set to the same SHA.

## Risk + rollback
Adds one workflow that runs on pull_request and needs the CLAUDE_CODE_OAUTH_TOKEN secret. Revert this PR to remove it.

## Checklist
- [ ] CLAUDE_CODE_OAUTH_TOKEN secret is set
- [ ] REVIEWED label exists
- [ ] Actions allowlist includes the claude-code-action and setup-bun pins
BODY
}

harden_body() {
  cat <<BODY
## What
Updates .github/workflows/review.yml to the hardened caller from $REVIEW_SRC at ${REVIEW_SHA:0:7}: job-level fork guard, full-SHA pin of the reusable workflow, and tools-ref set to the same SHA (private repos also get the repo-specific runner label).

## Why
- Fork guard: without it a fork PR could schedule the job on a self-hosted runner, and on pull_request the workflow file comes from the PR.
- SHA pin: @main let a change to the reusable workflow, or to the verdict script loaded from tools-ref, reach every repo holding CLAUDE_CODE_OAUTH_TOKEN.
- Runner label: fleet convention is the repo-specific nuc-* label, not the shared nuc one.

## Proof
Generated by repo-bootstrap --review from examples/claude-review-caller.yml at $REVIEW_SHA. The file diff shows the \`if:\` guard, \`@<sha> # do-no-work ${REVIEW_SHA:0:7}\` and \`tools-ref\`.

## Risk + rollback
Only .github/workflows/review.yml changes. Fork PRs now skip the review entirely. Revert this PR to restore the previous caller.

## Checklist
- [ ] CLAUDE_CODE_OAUTH_TOKEN secret is set
- [ ] REVIEWED label exists
- [ ] CHANGELOG gate skipped via skip-changelog label (CI-only change)
BODY
}

label_skip_changelog() {
  jq -e '.[] | select(.name == "skip-changelog")' <<<"$LABELS" >/dev/null || return 0
  if [ "$DRY_RUN" = 1 ]; then
    printf 'dry  gh pr edit -R %s %s --add-label skip-changelog\n' "$REPO" "${1:-<new PR>}"
    return
  fi
  gh pr edit -R "$REPO" "$1" --add-label skip-changelog >/dev/null || die "failed to label $1 skip-changelog"
  echo "ok   skip-changelog applied to $1"
}

has_skip_label() { jq -e '.[] | select(.name == "skip-changelog")' <<<"$LABELS" >/dev/null; }

# open_pr <branch> <base> <title> <body-fn>: the label goes on in the create call so the
# opened event already carries it (CHANGELOG gates read labels from the event payload).
open_pr() {
  local pr label=()
  has_skip_label && label=(--label skip-changelog)
  if [ "$DRY_RUN" = 1 ]; then
    printf 'dry  gh pr create -R %s --base %s --head %s %s\n' "$REPO" "$2" "$1" "${label[*]:-}"
    ST_CALLER=planned
    return
  fi
  pr=$("$4" | gh pr create -R "$REPO" --base "$2" --head "$1" --title "$3" --body-file - ${label[@]+"${label[@]}"}) \
    || die "failed to open PR"
  echo "ok   caller PR opened: $pr${label[*]:+ (skip-changelog)}"
  ST_CALLER="pr-opened"
}

# put_caller <branch> <content> <blob-sha or empty> <message>
put_caller() {
  local args=(-f "message=$4" -f "branch=$1" -f "content=$(printf '%s\n' "$2" | base64 | tr -d '\n')")
  if [ -n "$3" ]; then args+=(-f "sha=$3"); fi
  apply "write $CALLER_PATH on $1" PUT "repos/$REPO/contents/$CALLER_PATH" "${args[@]}"
}

# read_branch_caller <ref>: sets BRANCH_CALLER, BRANCH_BLOB (empty when the file is absent)
read_branch_caller() {
  local out
  BRANCH_CALLER="" BRANCH_BLOB=""
  if out=$(raw_file "repos/$REPO/contents/$CALLER_PATH?ref=$1" 2>&1); then
    BRANCH_CALLER="$out"
    BRANCH_BLOB=$(gh api "repos/$REPO/contents/$CALLER_PATH?ref=$1" --jq .sha) \
      || die "failed to read $CALLER_PATH blob sha on $1"
    return
  fi
  grep -qi 'not found' <<<"$out" || die "failed to read $CALLER_PATH on $1: $out"
}

open_pr_url() {
  gh pr list -R "$REPO" --head "$1" --json url --jq '.[0].url // empty' || die "failed to list PRs for $1"
}

create_caller_pr() {
  local base="$1" rendered="$2" sha
  sha=$(gh api "repos/$REPO/git/ref/heads/$base" --jq .object.sha) || die "failed to read $base sha"
  apply "branch $REVIEW_BRANCH from $base" POST "repos/$REPO/git/refs" \
    -f "ref=refs/heads/$REVIEW_BRANCH" -f "sha=$sha"
  put_caller "$REVIEW_BRANCH" "$rendered" "" "[NO-TICKET] feat: add claude review caller"
  open_pr "$REVIEW_BRANCH" "$base" "[NO-TICKET] feat: add claude review caller" caller_body
}

open_harden_pr() {
  local base="$1" rendered="$2" blob="$3" sha
  sha=$(gh api "repos/$REPO/git/ref/heads/$base" --jq .object.sha) || die "failed to read $base sha"
  apply "branch $HARDEN_BRANCH from $base" POST "repos/$REPO/git/refs" \
    -f "ref=refs/heads/$HARDEN_BRANCH" -f "sha=$sha"
  put_caller "$HARDEN_BRANCH" "$rendered" "$blob" "$HARDEN_TITLE"
  open_pr "$HARDEN_BRANCH" "$base" "$HARDEN_TITLE" harden_body
}

# refresh_pr <branch> <pr-url> <rendered>: bring the caller on an open PR's branch up to date
refresh_pr() {
  local br="$1" url="$2" rendered="$3"
  read_branch_caller "$br"
  if [ -n "$BRANCH_BLOB" ] && [ "$BRANCH_CALLER" = "$rendered" ]; then
    echo "ok   caller PR already current: $url"
    ST_CALLER="pr-open"
    return
  fi
  label_skip_changelog "$url"
  put_caller "$br" "$rendered" "$BRANCH_BLOB" "$HARDEN_TITLE"
  if [ "$DRY_RUN" = 1 ]; then
    printf 'dry  gh pr comment %s (caller refreshed to %s)\n' "$url" "${REVIEW_SHA:0:7}"
    ST_CALLER=planned
  else
    printf 'repo-bootstrap refreshed %s: pin @%s, tools-ref, job-level fork guard.\n' "$CALLER_PATH" "$REVIEW_SHA" \
      | gh pr comment "$url" --body-file - >/dev/null || die "failed to comment on $url"
    echo "ok   caller PR $url updated"
    ST_CALLER="pr-updated"
  fi
}

setup_review_caller() {
  local base pr_open pr_harden tpl rendered
  base=$(gh api "repos/$REPO" --jq .default_branch) || die "failed to read default branch"
  pr_open=$(open_pr_url "$REVIEW_BRANCH")
  pr_harden=$(open_pr_url "$HARDEN_BRANCH")
  read_branch_caller "$base"
  tpl=$(raw_file "repos/$REVIEW_SRC/contents/examples/claude-review-caller.yml?ref=$REVIEW_SHA") \
    || die "failed to read caller example from $REVIEW_SRC"
  resolve_runs_on
  rendered=$(render_caller "$tpl")
  if [ -n "$pr_open" ]; then refresh_pr "$REVIEW_BRANCH" "$pr_open" "$rendered"; return; fi
  if [ -n "$pr_harden" ]; then refresh_pr "$HARDEN_BRANCH" "$pr_harden" "$rendered"; return; fi
  if [ -z "$BRANCH_BLOB" ]; then create_caller_pr "$base" "$rendered"; return; fi
  if [ "$BRANCH_CALLER" = "$rendered" ]; then
    echo "ok   caller $CALLER_PATH present and current"
    ST_CALLER=ok
    return
  fi
  open_harden_pr "$base" "$rendered" "$BRANCH_BLOB"
}

setup_review_secret() {
  local names name=CLAUDE_CODE_OAUTH_TOKEN
  names=$(gh secret list -R "$REPO" --json name --jq '.[].name') || die "failed to list secrets"
  if grep -qx "$name" <<<"$names"; then
    echo "ok   secret $name present"
    ST_SECRET=ok
    return
  fi
  if [ -z "${CLAUDE_CODE_OAUTH_TOKEN:-}" ]; then
    echo "fix: gh secret set $name -R $REPO   # long-lived token from: claude setup-token"
    ST_SECRET=missing
    return
  fi
  if [ "$DRY_RUN" = 1 ]; then
    echo "dry  gh secret set $name -R $REPO (value from env via stdin)"
    ST_SECRET=planned
    return
  fi
  printf '%s' "$CLAUDE_CODE_OAUTH_TOKEN" | gh secret set "$name" -R "$REPO" >/dev/null \
    || die "failed to set secret $name"
  echo "ok   secret $name set from env"
  ST_SECRET="set"
}

run_review() {
  local vis
  if [ "$PUBLIC" != 1 ]; then
    vis=$(gh repo view "$REPO" --json visibility --jq .visibility) || die "failed to read visibility"
    if [ "$vis" = PUBLIC ]; then PUBLIC=1; echo "note public repo: treating as --public"; fi
  fi
  if [ "$PUBLIC" = 1 ]; then
    case "${BOOTSTRAP_REVIEW_RUNS_ON:-}" in
      *self-hosted*) die "--public refuses a self-hosted runs-on for the review caller" ;;
    esac
  fi
  resolve_review_sha
  setup_label
  setup_review_allowlist
  setup_review_caller
  setup_review_secret
  if [ "$PUBLIC" = 1 ]; then warn_self_hosted; fi
  echo "summary label=$ST_LABEL allowlist=$ST_ALLOW caller=$ST_CALLER secret=$ST_SECRET"
}

main() {
  parse_args "$@"
  command -v gh >/dev/null || die "gh not found"
  command -v jq >/dev/null || die "jq not found"
  if [ "$REVIEW" = 1 ]; then run_review; return; fi
  setup_actions
  setup_repo
  setup_label
  setup_ruleset
  if [ "$PUBLIC" = 1 ]; then warn_self_hosted; fi
}

main "$@"
